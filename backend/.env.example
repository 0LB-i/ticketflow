# Desenvolvimento. Copie para .env (que não vai para o Git).
DATABASE_URL=postgresql+psycopg://chamados:chamados@localhost:5432/chamados
LOG_FORMAT=console
LOG_LEVEL=INFO
# Links dos e-mails apontam para o Vite em desenvolvimento.
APP_BASE_URL=http://localhost:5173
# Em http://localhost alguns navegadores recusam cookies Secure.
COOKIE_SECURE=false
# Sem SMTP_HOST, os e-mails aparecem no log do backend.
