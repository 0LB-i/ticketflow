# Fila de tarefas e rotinas diárias (e-mails, limpeza dos anexos e da fila): `chamados worker`
# (ARCHITECTURE.md 3.12). O SIGTERM do `systemctl stop` espera a tarefa em curso terminar.
[Unit]
Description=TicketFlow (worker)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=ticketflow
Group=ticketflow
EnvironmentFile=/etc/ticketflow/env
WorkingDirectory=/opt/ticketflow/backend
ExecStart=/opt/ticketflow/backend/.venv/bin/chamados worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ticketflow

[Install]
WantedBy=multi-user.target
