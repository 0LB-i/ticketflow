# API e telas do TicketFlow (ADR 0010, docs/18 §18.3 passo 8).
[Unit]
Description=TicketFlow (API e interface web)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=ticketflow
Group=ticketflow
EnvironmentFile=/etc/ticketflow/env
WorkingDirectory=/opt/ticketflow/backend
# 4 workers para 8 núcleos: o PostgreSQL, o worker de e-mails e o nginx usam os mesmos (docs/18
# §18.3). Com outro número de núcleos, cerca da metade deles.
ExecStart=/opt/ticketflow/backend/.venv/bin/uvicorn chamados.main:create_app --factory \
          --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ticketflow

[Install]
WantedBy=multi-user.target
